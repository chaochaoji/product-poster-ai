# ═══════════════════════════════════════════════════════
# Product AI — 环境变量配置
# 复制此文件为 .env，填入密钥即可
# ═══════════════════════════════════════════════════════

# ── 火山方舟（统一平台，一个 Key 搞定识别 + 生图） ─────
# 获取 Key：https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=你的火山方舟密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 商品识别模型（豆包多模态，图→文） ──────────────────
# 可选：doubao-1.5-vision-pro-32k | doubao-seed-2-0-lite-260428
RECOGNITION_MODEL=doubao-1.5-vision-pro-32k
RECOGNITION_MAX_RETRIES=3
RECOGNITION_TIMEOUT=60
RECOGNITION_TEMPERATURE=0.3
RECOGNITION_MAX_TOKENS=2048

# ── 生图模型（即梦 Seedream，文→图） ───────────────────
JIMENG_MODEL=doubao-seedream-5-0-260128
JIMENG_REMOVE_WATERMARK=true
